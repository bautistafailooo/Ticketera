{
  "name": "ticketera",
  "version": "1.0.0",
  "description": "Ticketera: API para venta de entradas a eventos",
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "prestart": "prisma generate",
    "start": "prisma migrate deploy && tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "prisma generate",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/seed.ts",
    "make-admin": "tsx src/make-admin.ts",
    "postinstall": "prisma generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bautistafailooo/Ticketera.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bautistafailooo/Ticketera/issues"
  },
  "homepage": "https://github.com/bautistafailooo/Ticketera#readme",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsqr": "^1.4.0",
    "nodemailer": "^10.0.13",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
