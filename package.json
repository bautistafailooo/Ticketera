    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.0",
