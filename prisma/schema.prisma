generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum EventStatus {
  DRAFT
  // Enviado por un organizador no confiable: espera que un administrador lo revise.
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  // Pausado por un administrador: sale de la cartelera y no vende.
  PAUSED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum UserRole {
  ORGANIZER
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(ORGANIZER)
  // Confiable: publica eventos sin revisión. Si no, cada evento pasa por un administrador.
  trustedAt    DateTime?
  // Suspendido: no puede publicar y sus eventos salen de la cartelera.
  suspendedAt  DateTime?
  // Cuenta de Mercado Pago conectada (OAuth): las ventas se cobran en esa cuenta.
  // Los tokens se guardan cifrados (ver src/payments/crypto.ts).
  mpUserId         String?
  mpAccessToken    String?
  mpRefreshToken   String?
  mpTokenExpiresAt DateTime?
  mpConnectedAt    DateTime?
  createdAt    DateTime  @default(now())
  events       Event[]
  sessions     Session[]
  resets       PasswordReset[]
}

// Link de "olvidé mi contraseña". Se guarda el hash del token, nunca el token.
model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Event {
  id          String       @id @default(cuid())
  organizer   User?        @relation(fields: [organizerId], references: [id])
  organizerId String?
  name        String
  description String?
  // Nombre del archivo del flyer dentro de la carpeta de subidas.
  imageFile   String?
  venue       String
  // Dirección para el mapa y el botón "Cómo llegar" (opcional).
  address     String?
  startsAt    DateTime
  status      EventStatus  @default(DRAFT)
  // Clave del link de puerta: permite validar entradas de este evento sin cuenta.
  doorToken   String?      @unique
  // Motivo del último rechazo o pausa, visible para el organizador.
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime     @default(now())
  ticketTypes TicketType[]
  orders      Order[]
}

model TicketType {
  id         String   @id @default(cuid())
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    String
  name       String
  priceCents Int
  capacity   Int
  sold       Int      @default(0)
  tickets    Ticket[]

  @@unique([eventId, name])
}

model Order {
  id          String      @id @default(cuid())
  event       Event       @relation(fields: [eventId], references: [id])
  eventId     String
  // Clave secreta para que el comprador vea su orden y sus entradas.
  accessToken String      @unique
  buyerName   String
  buyerEmail  String
  status      OrderStatus @default(PENDING)
  // Total que paga el comprador: entradas + cargo por servicio.
  totalCents  Int
  // Cargo por servicio (la comisión de ecko). Lo paga el comprador.
  feeCents    Int         @default(0)
  // Pago de Mercado Pago que confirmó la orden (o que se devolvió por llegar tarde).
  mpPaymentId String?     @unique
  paidAt      DateTime?
  // Si el pago llegó cuando la orden ya no se podía cumplir, se devuelve.
  refundedAt  DateTime?
  // Si no se paga antes de esta fecha, la orden vence y libera el cupo.
  expiresAt   DateTime?
  // Última vez que se mandaron las entradas por mail.
  emailedAt   DateTime?
  createdAt   DateTime    @default(now())
  tickets     Ticket[]

  @@index([status, expiresAt])
}

model Ticket {
  id           String     @id @default(cuid())
  code         String     @unique
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  ticketTypeId String
  // Precio al momento de la compra.
  priceCents   Int
  usedAt       DateTime?
  createdAt    DateTime   @default(now())
}
