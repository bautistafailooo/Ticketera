DATABASE_URL="file:./dev.db"
PORT=3000

# En producción: NODE_ENV=production (cookies Secure, HSTS y pago simulado apagado).
# NODE_ENV=production

# Minutos para pagar antes de que una orden venza y libere el cupo.
ORDER_TTL_MINUTES=15

# Pago simulado: por defecto activado en desarrollo y apagado en producción.
# SIMULATED_PAYMENTS=true

# Cantidad de proxies delante del servidor (por ejemplo 1 detrás de un balanceador).
# TRUST_PROXY=1

# Carpeta donde se guardan los flyers de los eventos.
UPLOAD_DIR=uploads

# Dirección pública del sitio (para los links de los mails).
PUBLIC_URL=http://localhost:3000

# Envío de mails. Sin esto, los mails se guardan en la carpeta mail-outbox/ para verlos en el navegador.
# SMTP_URL=smtps://usuario:clave@smtp.resend.com:465
# MAIL_FROM="ecko <entradas@tudominio.com>"
