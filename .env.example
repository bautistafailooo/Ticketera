DATABASE_URL="file:./dev.db"
PORT=3000

# En producción: NODE_ENV=production (cookies Secure, HSTS y pago simulado apagado).
# NODE_ENV=production

# Minutos para pagar antes de que una orden venza y libere el cupo.
ORDER_TTL_MINUTES=15

# Pago simulado: por defecto activado en desarrollo y apagado en producción.
# SIMULATED_PAYMENTS=true

# Cantidad de proxies delante del servidor (por ejemplo 1 detrás de un balanceador).
# TRUST_PROXY=1

# Carpeta donde se guardan los flyers de los eventos.
UPLOAD_DIR=uploads

# Dirección pública del sitio (para los links de los mails).
PUBLIC_URL=http://localhost:3000

# Envío de mails (paso a paso en MAILS.md). Sin esto, los mails se guardan en la carpeta
# mail-outbox/ para verlos en el navegador. Para probar: npm run probar-mail -- tu@email.com
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=tu@gmail.com
# SMTP_PASS=contraseña-de-aplicacion
# SMTP_PORT=465
# MAIL_FROM="ecko <entradas@tudominio.com>"   (si falta, se usa SMTP_USER)
# También se puede todo en una línea: SMTP_URL=smtps://usuario:clave@servidor:465

# Mercado Pago (paso a paso en MERCADOPAGO.md). Sin esto, no se cobra con Mercado Pago.
# MP_CLIENT_ID=
# MP_CLIENT_SECRET=
# Cargo por servicio que paga el comprador (% sobre el valor de las entradas).
# SERVICE_FEE_PERCENT=10

# --- Producción (ver DEPLOY.md) ---
# La cuenta con este email pasa a ser administrador al arrancar el servidor.
# ADMIN_EMAIL=tu@email.com
# Contraseña para entrar a todo el sitio mientras está en privado.
# SITE_PASSWORD=una-contraseña
# Carpeta de las copias de seguridad diarias de la base (se guardan las últimas 7).
# BACKUP_DIR=/data/backups
